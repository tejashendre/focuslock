{
  "manifest_version": 3,
  "name": "FocusLock - 25/5 Focus Sandbox",
  "version": "1.1.0",
  "description": "Enforced single-tab fullscreen focus on a 25/5 loop. Built to make context-switching physically impossible rather than relying on willpower.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "sidePanel",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "FocusLock - lock into one tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}